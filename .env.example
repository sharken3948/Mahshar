# ─── Supabase ────────────────────────────────────────────────────────────────
# Required. Find these in your Supabase project → Settings → API.

# Public URL of your Supabase project (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co

# Public anon key — used by the browser client (safe to expose client-side)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Service role key — full admin access to the DB. NEVER expose client-side.
SUPABASE_SERVICE_ROLE_KEY=

# ─── Groq ────────────────────────────────────────────────────────────────────
# Required. Used for AI scoring and natural-language API matching.
# Get your key at https://console.groq.com
GROQ_API_KEY=

# ─── Arc Mainnet / Circle Gateway ────────────────────────────────────────────
# Required server-side for Arc Mainnet verification, settlement-adjacent RPC
# reads, withdrawals, and Memo receipts. The installed Gateway client must be
# given this URL explicitly for chain `arc`.
ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io/

# Optional browser-safe, non-secret RPC override. Must allow browser CORS and
# must be Arc Mainnet (chain ID 5042). Never put a credential-bearing URL here.
# When omitted, passive balance reads start with Arc's official public RPC.
NEXT_PUBLIC_ARC_MAINNET_RPC_URL=https://rpc.mainnet.arc.io/

# Optional, server-only. Enables the Circle-hosted Arc USDC Onramp flow.
# Leave unset until Circle/provider production onboarding is complete.
CIRCLE_ONRAMP_API_KEY=

# ─── Encryption ──────────────────────────────────────────────────────────────
# Required. AES-256-GCM key for encrypting seller API keys at rest.
# Must be exactly 64 lowercase hex characters (32 bytes).
# Generate with: openssl rand -hex 32
ENCRYPTION_KEY=

# ─── Platform Wallet ─────────────────────────────────────────────────────────
# Required. The platform wallet that receives buyer payments and forwards
# the seller share via the Circle Gateway on Arc Mainnet.

# Ethereum address of the platform wallet (0x + 40 hex chars)
PLATFORM_WALLET_ADDRESS=0x

# Private key of the platform wallet. NEVER commit this. NEVER expose client-side.
PLATFORM_WALLET_PRIVATE_KEY=0x

# ─── Internal API Secret ─────────────────────────────────────────────────────
# Required. Shared secret for server-to-server calls (e.g. credits topup/deduct).
# Must be a long random string. NEVER expose client-side.
# Generate with: openssl rand -hex 32
INTERNAL_API_SECRET=

# Server-only comma-separated EVM wallet allowlist. Admin routes require a
# valid wallet session belonging to a member of this list.
ADMIN_WALLETS=

# Required for the Vercel Cron response-retention job. Server-only, at least
# 32 random characters; Vercel sends it in the Authorization header.
CRON_SECRET=

# ─── Autonomous-agent test harness ──────────────────────────────────────────
# Dry run is the default and needs only MAHSHAR_BASE_URL. Live mode is manually
# gated and refuses listings above 0.001 USDC. Never commit or log the test key.
MAHSHAR_BASE_URL=http://localhost:3000
MAHSHAR_AGENT_E2E_LIVE=false
MAHSHAR_AGENT_E2E_MAX_LISTING_USDC=0.001
MAHSHAR_AGENT_E2E_PRIVATE_KEY=

# Optional on non-Vercel deployments only. Set this only when the named header
# is overwritten by a trusted edge proxy.
# MAHSHAR_TRUSTED_CLIENT_IP_HEADER=x-forwarded-for

# Internal deterministic upstream fixtures. Keep disabled unless deliberately
# running the paid test matrix; every secret is server-only and must be unique.
ENABLE_TEST_MATRIX_ENDPOINTS=false
TEST_MATRIX_API_KEY_POST_SECRET=
TEST_MATRIX_BEARER_PUT_SECRET=
TEST_MATRIX_QUERY_DELETE_SECRET=

# ─── App URL ─────────────────────────────────────────────────────────────────
# Optional browser-facing metadata origin.
NEXT_PUBLIC_APP_URL=https://mahshar.xyz

# Required in production. Canonical HTTPS origin used for all machine-readable
# discovery, OpenAPI, proxy, and x402 execution URLs.
MARKETPLACE_ORIGIN=https://mahshar.xyz
